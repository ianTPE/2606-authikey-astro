					</svg>
				</a>
				<input type="checkbox" id="nav-toggle" class="nav-toggle" />
				<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
					<span></span><span></span><span></span>
				</label>
				<nav class="site-nav">
					{navItems.map((item) => (
						<a href={item.href} class={isActive(item.href) ? "active" : ""}>{item.label}</a>
					))}
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div>
					<strong>Authikey</strong>
					<p>
						2-in-1 reversible TPM 2.0 + 1.2 modules for 2013–2018 motherboards.
						Based in Taipei, Taiwan. Worldwide shipping.
					</p>
				</div>
				<div>
					<strong>Buy by email</strong>
					<p>
						No online checkout — tell us which kit you need and your country:<br />
						<a href="mailto:sales@authikey.com">sales@authikey.com</a>
					</p>
				</div>
				<div>
					<strong>Pages</strong>
					<p class="footer-links">
						{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
					</p>
				</div>
			</div>
			<div class="container copyright">
				© {new Date().getFullYear()} Authikey. All rights reserved.
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f7f5f0;
		--surface: #ffffff;
		--surface-2: #efece6;
		--border: #e4dfd5;
		--text: #1a1917;
		--text-muted: #706b61;
		--accent: #dc2125;
		--accent-strong: #b0161a;
		--accent-contrast: #ffffff;
		--max-width: 1060px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
		background: var(--bg);
		color: var(--text);
		line-height: 1.65;
	}

	h1, h2, h3 {
		line-height: 1.25;
	}

	a {
		color: var(--accent);
	}

	.container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 1.25rem;
	}

	/* Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(247, 245, 240, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		min-height: 60px;
	}

	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo-svg {
		height: 28px;
		width: auto;
		display: block;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.brand:hover .logo-svg {
		opacity: 0.85;
		transform: scale(1.02);
	}

	.site-nav {
		display: flex;
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.site-nav a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.95rem;
		padding: 0.35rem 0;
		border-bottom: 2px solid transparent;
	}

	.site-nav a:hover {
		color: var(--text);
	}

	.site-nav a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.nav-toggle {
		display: none;
	}

	.nav-toggle-label {
		display: none;
		flex-direction: column;
		gap: 5px;
		cursor: pointer;
		padding: 0.5rem;
	}

	.nav-toggle-label span {
		width: 22px;
		height: 2px;
		background: var(--text);
	}

	@media (max-width: 780px) {
		.nav-toggle-label {
			display: flex;
		}

		.site-nav {
			display: none;
			flex-direction: column;
			gap: 0;
			width: 100%;
			padding-bottom: 0.75rem;
		}

		.nav-toggle:checked ~ .site-nav {
			display: flex;
		}

		.site-nav a {
			padding: 0.6rem 0;
			border-bottom: 1px solid var(--border);
		}

		.site-nav a.active {
			border-bottom-color: var(--accent);
		}
	}

	/* Shared section styles */
	.section {
		padding: 3.5rem 0;
	}

	.section.alt {
		background: var(--surface);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.section h2 {
		font-size: 1.7rem;
		margin: 0 0 0.5rem;
	}

	.section .lede {
		color: var(--text-muted);
		max-width: 46rem;
		margin-top: 0;
	}

	.card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.4rem;
	}

	.section.alt .card {
		background: var(--surface-2);
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		font-size: 1rem;
	}

	.btn-primary {
		background: var(--accent);
		color: var(--accent-contrast);
	}

	.btn-primary:hover {
		background: var(--accent-strong);
	}

	.btn-secondary {
		border: 1px solid var(--accent);
		color: var(--accent);
	}

	.btn-secondary:hover {
		background: rgba(220, 33, 37, 0.08);
	}

	.badge {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: rgba(220, 33, 37, 0.08);
		color: var(--accent);
		border: 1px solid rgba(220, 33, 37, 0.25);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	th, td {
		text-align: left;
		padding: 0.6rem 0.8rem;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}

	th {
		color: var(--text-muted);
		font-weight: 600;
		white-space: nowrap;
	}

	code {
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.1rem 0.4rem;
		font-size: 0.9em;
	}

	/* Footer */
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		padding: 2.5rem 0 1.5rem;
		margin-top: 4rem;
		font-size: 0.92rem;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2rem;
		color: var(--text-muted);
	}

	.footer-inner strong {
		color: var(--text);
	}

	.footer-links a {
		display: block;
		text-decoration: none;
		padding: 0.1rem 0;
	}

	.copyright {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.85rem;
	}
</style>
