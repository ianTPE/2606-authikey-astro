---
import Layout from "../layouts/Layout.astro";
import EmailCta from "../components/EmailCta.astro";

const kits = [
	{ brand: "ASUS", adapter: "14-1 pin adapter board", note: "Z170–Z390 era boards use the 14-1 pin header; older boards use 20-1 pin directly." },
	{ brand: "Gigabyte", adapter: "12-1 pin adapter board", note: "Newer Gigabyte boards (Z370/Z390, AM4 500) use 12-1 pin; older boards use 20-1 pin." },
	{ brand: "MSI", adapter: "14-1 pin adapter board", note: "Most MSI boards in range use the 14-1 pin JTPM1 header." },
	{ brand: "ASRock", adapter: "18-1 pin adapter board", note: "ASRock boards use an 18-1 pin TPM header." },
];

const slides = [
	{
		src: "/2in1-Authikey.jpg",
		alt: "Front of the Authikey 2-in-1 reversible TPM module",
		eyebrow: "Upgrade with ease",
		heading: "2-in-1 reversible TPM 2.0 + 1.2",
	},
	{
		src: "/asus-13pin-demo.jpg",
		alt: "Authikey TPM module installed on an ASUS motherboard header",
		eyebrow: "Supports most",
		heading: "ASUS, Gigabyte, MSI & ASRock motherboards",
	},
	{
		src: "/2in1-back.jpg",
		alt: "Back of the Authikey 2-in-1 reversible TPM module",
		eyebrow: "For Windows 11 installation",
		heading: "Flip it over — TPM 2.0 ↓ / 1.2 ↑",
	},
];
---

<Layout
	title="Authikey — TPM 2.0 / 1.2 Modules for 2013–2018 Motherboards"
	description="2-in-1 reversible TPM 2.0 + 1.2 hardware modules for ASUS, Gigabyte, MSI and ASRock motherboards (2013–2018, LPC bus). Install Windows 11 on older PCs. Order by email."
>
	<section class="hero" data-slider aria-roledescription="carousel" aria-label="Authikey TPM modules">
		<div class="hero-track" data-track>
			{slides.map((slide, i) => (
				<article
					class={`hero-slide${i === 0 ? " is-active" : ""}`}
					data-slide
					role="group"
					aria-roledescription="slide"
					aria-label={`${i + 1} of ${slides.length}`}
					aria-hidden={i === 0 ? "false" : "true"}
				>
					<div class="hero-slide-inner container">
						<div class="hero-text">
							<p class="hero-eyebrow">{slide.eyebrow}</p>
							<h1 class="hero-heading">{slide.heading}</h1>
							<p class="hero-sub"><strong>US$53 per kit</strong> · adapter board included · ships from Taipei</p>
							<div class="hero-actions">
								<a class="btn btn-primary" href="/products/">View products</a>
								<a class="btn btn-secondary" href="/how-to-buy/">How to buy by email</a>
							</div>
						</div>
						<div class="hero-figure">
							<img src={slide.src} alt={slide.alt} class="hero-img" loading={i === 0 ? "eager" : "lazy"} />
						</div>
					</div>
				</article>
			))}
		</div>

		<button type="button" class="slider-arrow prev" data-prev aria-label="Previous slide">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>
		<button type="button" class="slider-arrow next" data-next aria-label="Next slide">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>

		<div class="slider-dots" role="tablist" aria-label="Choose slide">
			{slides.map((_, i) => (
				<button
					type="button"
					class={`dot${i === 0 ? " is-active" : ""}`}
					data-dot
					role="tab"
					aria-selected={i === 0 ? "true" : "false"}
					aria-label={`Go to slide ${i + 1}`}
				></button>
			))}
		</div>
	</section>

	<section class="section">
		<div class="container">
			<h2>Is this the right module for your board?</h2>
			<p class="lede">
				Answer these four questions before you order — they decide everything.
			</p>
			<div class="grid">
				<div class="card">
					<h3>Does your motherboard have a TPM header?</h3>
					<p>
						Look for a header labeled <code>TPM</code> or <code>JTPM1</code> near 
						the bottom edge of the board, or check your	motherboard manual. No 
						header — no way to install a module.
					</p>
				</div>
				<div class="card">
					<h3>Was it made between 2013 and 2018?</h3>
					<p>
						Our modules use the <strong>LPC bus</strong>. Boards made after 2018
						switched to the SPI bus and are <strong>not compatible</strong>. Boards
						before 2013 often lack the UEFI BIOS that Windows 11 requires.
					</p>
				</div>
				<div class="card">
					<h3>Do you need TPM 2.0 or 1.2?</h3>
					<p>
						Microsoft officially lists TPM 2.0 as the upgrade requirement for Windows 11,
						but Windows 11 still supports TPM 1.2 internally. Of the thousands of
						2-in-1 TPM modules we have sold, over a third of users installed Windows 11
						using TPM 1.2. Our module is reversible — flip it to switch versions,
						no firmware flashing needed.
					</p>
				</div>
				<div class="card">
					<h3>AMD user with fTPM stuttering?</h3>
					<p>
						On some AM4+ boards, enabling firmware fTPM causes periodic system
						stutter. A discrete hardware TPM module avoids the issue entirely.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<h2>Four kits, one price — US$53</h2>
			<p class="lede">
				Every kit contains the same 2-in-1 reversible 20-1 pin TPM module plus a
				brand-specific adapter board. Pick the kit that matches your motherboard brand.
			</p>
			<div class="grid">
				{kits.map((kit) => (
					<div class="card kit-card">
						<h3>{kit.brand} kit</h3>
						<p class="adapter">20-1 pin module + {kit.adapter}</p>
						<p>{kit.note}</p>
					</div>
				))}
			</div>
			<p class="grid-footnote">
				Full chipset lists for each kit are on the
				<a href="/products/">Products &amp; Compatibility</a> page.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<h2>How buying works</h2>
			<p class="lede">
				We no longer run an online checkout. Ordering is a short email exchange —
				you get a compatibility check from a human before you pay.
			</p>
			<ol class="steps">
				<li><strong>Check compatibility</strong> — confirm your board's brand, year and TPM header on the <a href="/products/">products page</a>.</li>
				<li><strong>Email us</strong> — tell us which of the four kits you need (ASUS / Gigabyte / MSI / ASRock) and your shipping country.</li>
				<li><strong>We confirm</strong> — we verify compatibility and reply with shipping cost and a payment link.</li>
				<li><strong>Pay &amp; receive</strong> — pay via the link, and we ship from Taipei, Taiwan with tracking.</li>
			</ol>
			<EmailCta />
		</div>
	</section>

	<script>
		const slider = document.querySelector<HTMLElement>("[data-slider]");
		if (slider) {
			const track = slider.querySelector<HTMLElement>("[data-track]");
			const slides = Array.from(slider.querySelectorAll<HTMLElement>("[data-slide]"));
			const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>("[data-dot]"));
			const prev = slider.querySelector<HTMLButtonElement>("[data-prev]");
			const next = slider.querySelector<HTMLButtonElement>("[data-next]");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			let current = 0;
			let timer: ReturnType<typeof setInterval> | undefined;

			const show = (index: number) => {
				current = (index + slides.length) % slides.length;
				if (track) track.style.transform = `translateX(-${current * 100}%)`;
				slides.forEach((slide, i) => {
					const active = i === current;
					slide.classList.toggle("is-active", active);
					slide.setAttribute("aria-hidden", active ? "false" : "true");
				});
				dots.forEach((dot, i) => {
					const active = i === current;
					dot.classList.toggle("is-active", active);
					dot.setAttribute("aria-selected", active ? "true" : "false");
				});
			};

			const stop = () => {
				if (timer) clearInterval(timer);
				timer = undefined;
			};

			const start = () => {
				if (reduceMotion || slides.length < 2) return;
				stop();
				timer = setInterval(() => show(current + 1), 5000);
			};

			prev?.addEventListener("click", () => { show(current - 1); start(); });
			next?.addEventListener("click", () => { show(current + 1); start(); });
			dots.forEach((dot, i) => dot.addEventListener("click", () => { show(i); start(); }));

			slider.addEventListener("mouseenter", stop);
			slider.addEventListener("mouseleave", start);
			slider.addEventListener("focusin", stop);
			slider.addEventListener("focusout", start);

			start();
		}
	</script>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
		background:
			radial-gradient(ellipse at 80% 20%, rgba(220, 33, 37, 0.06), transparent 55%),
			var(--bg);
	}

	.hero-track {
		display: flex;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
		will-change: transform;
	}

	.hero-slide {
		flex: 0 0 100%;
		min-width: 100%;
	}

	.hero-slide-inner {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 3rem;
		align-items: center;
		padding-top: 3.5rem;
		padding-bottom: 3.5rem;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.hero-heading {
		margin: 0 0 1rem;
		max-width: 16ch;
		font-size: clamp(1.9rem, 4vw, 2.7rem);
		line-height: 1.15;
		color: var(--text);
	}

	.hero-sub {
		margin: 0 0 1.6rem;
		font-size: 1.05rem;
		color: var(--text-muted);
	}

	.hero-sub strong {
		color: var(--text);
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-figure {
		display: flex;
		justify-content: center;
	}

	.hero-img {
		display: block;
		width: 100%;
		max-width: 440px;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 12px;
		border: 1px solid var(--border);
		box-shadow: 0 15px 35px rgba(26, 25, 23, 0.08), 0 5px 15px rgba(26, 25, 23, 0.04);
	}

	.slider-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: blur(4px);
		color: var(--text);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.25s ease, background 0.2s ease, color 0.2s ease;
	}

	.hero:hover .slider-arrow,
	.slider-arrow:focus-visible {
		opacity: 1;
	}

	.slider-arrow:hover {
		background: #fff;
		color: var(--accent);
	}

	.slider-arrow.prev {
		left: 0.75rem;
	}

	.slider-arrow.next {
		right: 0.75rem;
	}

	.slider-dots {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1rem;
		z-index: 3;
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	.dot {
		width: 0.55rem;
		height: 0.55rem;
		padding: 0;
		border-radius: 999px;
		border: none;
		background: var(--border);
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}

	.dot:hover {
		background: var(--text-muted);
	}

	.dot.is-active {
		background: var(--accent);
		transform: scale(1.25);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-track {
			transition: none;
		}
	}

	@media (max-width: 868px) {
		.hero-slide-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
			padding-top: 2.5rem;
			padding-bottom: 3rem;
		}
		.hero-text {
			align-items: center;
			order: 2;
		}
		.hero-figure {
			order: 1;
		}
		.hero-heading {
			max-width: none;
		}
		.hero-actions {
			justify-content: center;
		}
		.hero-img {
			max-width: 320px;
		}
		.slider-arrow {
			opacity: 1;
		}
		.slider-dots {
			bottom: 0.5rem;
		}
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.2rem;
		margin-top: 1.8rem;
	}

	.card h3 {
		margin-top: 0;
		font-size: 1.08rem;
	}

	.kit-card .adapter {
		color: var(--accent);
		font-weight: 600;
		font-size: 0.92rem;
	}

	.grid-footnote {
		margin-top: 1.5rem;
		color: var(--text-muted);
	}

	.steps {
		max-width: 44rem;
		padding-left: 1.4rem;
		margin: 1.5rem 0 2rem;
	}

	.steps li {
		margin-bottom: 0.9rem;
	}
</style>
