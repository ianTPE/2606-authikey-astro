---
import Layout from "../../layouts/Layout.astro";
import EmailCta from "../../components/EmailCta.astro";
import { kits, type Kit } from "../../data/kits";

export function getStaticPaths() {
	return kits.map((kit) => ({
		params: { slug: kit.slug },
		props: { kit },
	}));
}

interface Props {
	kit: Kit;
}

const { kit } = Astro.props;
const others = kits.filter((k) => k.id !== kit.id);
---

<Layout
	title={`${kit.brand} TPM 2.0 + 1.2 Kit — US$53 | Authikey`}
	description={`2-in-1 reversible TPM 2.0 + 1.2 module for ${kit.brand} motherboards (2013–2018, LPC bus), with the ${kit.adapter} included. Full chipset compatibility list. US$53 per kit, ordered by email.`}
>
	<section class="section">
		<div class="container">
			<p class="crumbs">
				<a href="/shop/">Shop</a> / <span>{kit.brand} TPM kit</span>
			</p>

			<div class="product-top">
				<div class="product-figure">
					<img
						src="/2in1-Authikey.jpg"
						alt={`Authikey 2-in-1 reversible TPM module for ${kit.brand} motherboards`}
						loading="eager"
					/>
				</div>
				<div class="product-summary">
					<h1>{kit.brand} TPM 2.0 + 1.2 Kit</h1>
					<p class="price"><span class="badge">US$53</span> per kit · adapter board included</p>
					<p class="lede">
						2-in-1 reversible TPM module (TPM 2.0 on one side, TPM 1.2 on the other)
						bundled with the <strong>{kit.adapter}</strong> for {kit.brand}
						motherboards. Enable Windows 11 on a 2013–2018 board without flashing firmware.
					</p>
					<ul class="quick">
						<li><strong>Header types:</strong> {kit.headers}</li>
						<li><strong>Bus:</strong> LPC (boards after 2018 use SPI and are not supported)</li>
						<li><strong>In the box:</strong> reversible 20-1 pin TPM module + {kit.adapter}</li>
					</ul>
					<div class="cta-block">
						<EmailCta subject={`${kit.brand} TPM kit order`} />
						<p class="buy-note">
							No online checkout — email us your exact board model and country and we
							confirm compatibility before you pay. See <a href="/how-to-buy/">how to buy</a>.
						</p>
					</div>
				</div>
			</div>

			<div class="card">
				<h2>{kit.brand} compatibility</h2>
				<table>
					<tbody>
						<tr><th>Header types</th><td>{kit.headers}</td></tr>
						<tr><th>Adapter included</th><td>{kit.adapter}</td></tr>
						<tr><th>Intel chipsets (20-1 pin, direct)</th><td>{kit.intelDirect}</td></tr>
						<tr><th>Intel chipsets (via adapter)</th><td>{kit.intelAdapter}</td></tr>
						<tr><th>AMD platforms</th><td>{kit.amd}</td></tr>
					</tbody>
				</table>
				<p class="note">{kit.note}</p>
			</div>

			<div class="card spec-card">
				<h2>Shared specifications</h2>
				<table>
					<tbody>
						<tr><th>Chips</th><td>2 × Infineon SLB9665 (one per side)</td></tr>
						<tr><th>TPM 2.0 firmware</th><td>5.63.3353.0</td></tr>
						<tr><th>TPM 1.2 firmware</th><td>4.43.259.0</td></tr>
						<tr><th>Board years</th><td>2013–2018 UEFI motherboards</td></tr>
						<tr><th>Compliance</th><td>Windows Security Processor compliant; every module tested before shipping</td></tr>
						<tr><th>Price</th><td>US$53 per kit</td></tr>
					</tbody>
				</table>
				<p class="note">
					Full chipset lists for every brand are on the
					<a href="/products/">Products &amp; Compatibility</a> page.
				</p>
			</div>

			<div class="card other-kits">
				<h2>Other kits</h2>
				<ul class="kit-links">
					{others.map((k) => (
						<li><a href={`/product/${k.slug}/`}>{k.brand} TPM kit</a></li>
					))}
				</ul>
			</div>
		</div>
	</section>
</Layout>

<style>
	.crumbs {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 1.2rem;
	}
	.crumbs a {
		text-decoration: none;
	}

	.product-top {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 2.5rem;
		align-items: start;
		margin-bottom: 2.5rem;
	}

	.product-figure img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		border: 1px solid var(--border);
		box-shadow: 0 15px 35px rgba(26, 25, 23, 0.08), 0 5px 15px rgba(26, 25, 23, 0.04);
	}

	h1 {
		font-size: 2rem;
		margin: 0 0 0.6rem;
	}

	.price {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1.05rem;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}

	.quick {
		list-style: none;
		padding: 0;
		margin: 1rem 0 1.5rem;
		display: grid;
		gap: 0.5rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.cta-block {
		margin-top: 1.5rem;
	}

	.buy-note {
		margin-top: 1rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.card {
		margin-bottom: 1.5rem;
	}

	.card h2 {
		margin-top: 0;
		font-size: 1.25rem;
	}

	.note {
		margin: 0.8rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.kit-links {
		margin: 0;
		padding-left: 1.2rem;
	}

	.kit-links li {
		margin-bottom: 0.4rem;
	}

	@media (max-width: 780px) {
		.product-top {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
